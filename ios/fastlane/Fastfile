default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight (internal) on push to main"
  lane :beta do
    require 'yaml'
    require 'fileutils'

    UI.message("Setting up CI environment")
    unless ENV['CI']
      UI.user_error!("This lane must be run in CI environment (ENV['CI'] is not set)")
    end
    setup_ci

    UI.message("Setting up App Store Connect API key")
    api_key = app_store_connect_api_key(
      key_id: ENV['APP_STORE_CONNECT_KEY_ID'],
      issuer_id: ENV['APP_STORE_CONNECT_ISSUER_ID'],
      key_content: ENV['APP_STORE_CONNECT_API_KEY']
    )

    UI.message("Syncing code signing via match (readonly in CI)")
    match(
      type: "appstore",
      app_identifier: [ENV['APP_BUNDLE_ID']],
      git_url: ENV['MATCH_GIT_URL'],
      readonly: true,
      api_key: api_key
    )

    UI.message("Configuring manual code signing for Release build")
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      targets: ["Runner"],
      build_configurations: ["Release", "Profile"],
      team_id: ENV['APPLE_TEAM_ID'],
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore #{ENV['APP_BUNDLE_ID']}"
    )

    UI.message("Reading version from pubspec.yaml")
    pubspec = YAML.load_file(File.expand_path("../../pubspec.yaml", __dir__))
    marketing_version = pubspec['version'].split('+').first

    UI.message("Getting latest build number from TestFlight")
    latest_build = (latest_testflight_build_number(
      api_key: api_key,
      app_identifier: ENV['APP_BUNDLE_ID'],
      version: marketing_version
    ) rescue 0)
    build_number = (latest_build + 1).to_s
    UI.message("Resolved marketing version=#{marketing_version} next build_number=#{build_number}")

    # Persist build info for CI summary
    build_info_path = File.expand_path("../../build/build_info.env", __dir__)
    FileUtils.mkdir_p(File.dirname(build_info_path)) unless Dir.exist?(File.dirname(build_info_path))
    File.write(build_info_path, "MARKETING_VERSION=#{marketing_version}\nBUILD_NUMBER=#{build_number}\n")

    # Build and upload
    UI.message("Building IPA via gym (build_app)")
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: ENV['APPLE_TEAM_ID'],
        provisioningProfiles: {
          ENV['APP_BUNDLE_ID'] => "match AppStore #{ENV['APP_BUNDLE_ID']}"
        }
      },
      xcargs: "FLUTTER_BUILD_NAME=#{marketing_version} FLUTTER_BUILD_NUMBER=#{build_number}"
    )

    UI.message("Uploading IPA to TestFlight (internal)")
    upload_to_testflight(
      api_key: api_key,
      skip_submission: true
    )
  end
end
