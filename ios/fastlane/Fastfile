default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight (internal) on push to main"
  lane :beta do
    require 'yaml'
    require 'fileutils'

    UI.message("Setting up CI environment")
    setup_ci()

    UI.message("Setting up App Store Connect API key")
    api_key = app_store_connect_api_key(
      key_id: ENV['APP_STORE_CONNECT_KEY_ID'],
      issuer_id: ENV['APP_STORE_CONNECT_ISSUER_ID'],
      key_content: ENV['APP_STORE_CONNECT_API_KEY']
    )

    UI.message("Syncing code signing via match (readonly in CI)")
    match(
      type: "appstore",
      app_identifier: [ENV['APP_BUNDLE_ID']],
      git_url: ENV['MATCH_GIT_URL'],
      readonly: true,
      api_key: api_key
    )

    UI.message("Configuring manual code signing for Release build")
    automatic_code_signing(
      path: "Runner.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV['APPLE_TEAM_ID']
    )
    # Apply manual signing for Runner (Release + Profile) with profile
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      targets: ["Runner"],
      build_configurations: ["Release", "Profile"],
      team_id: ENV['APPLE_TEAM_ID'],
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore #{ENV['APP_BUNDLE_ID']}"
    )
    # Ensure tests target is manual too (no profile needed)
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      targets: ["RunnerTests"],
      build_configurations: ["Release", "Profile"],
      team_id: ENV['APPLE_TEAM_ID']
    )

    UI.message("Reading version from pubspec.yaml")
    pubspec = YAML.load_file(File.expand_path("../../pubspec.yaml", __dir__))
    version_str = pubspec['version']
    marketing_version = version_str.split('+').first

    latest = (latest_testflight_build_number(
      api_key: api_key,
      app_identifier: ENV['APP_BUNDLE_ID'],
      version: marketing_version
    ) rescue nil) || 0
    build_number = (latest.to_i + 1).to_s
    UI.message("Resolved marketing version=#{marketing_version} next build_number=#{build_number}")

    # Persist build info for CI summary
    build_info_path = File.expand_path("../../build/build_info.env", __dir__)
    FileUtils.mkdir_p(File.dirname(build_info_path)) unless Dir.exist?(File.dirname(build_info_path))
    File.write(build_info_path, "MARKETING_VERSION=#{marketing_version}\nBUILD_NUMBER=#{build_number}\n")

    # Build and upload
    # Ensure deps are up to date and build IPA via gym with explicit signing/export options
    sh("flutter", "--version")
    sh("flutter", "pub", "get")

    UI.message("Installing CocoaPods dependencies")
    sh("bundle", "exec", "pod", "install")

    UI.message("Building IPA via gym (build_ios_app)")
    output_dir = File.expand_path("../../build/ios/ipa", __dir__)
    FileUtils.mkdir_p(output_dir) unless Dir.exist?(output_dir)

    build_ios_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: ENV['APPLE_TEAM_ID'],
        provisioningProfiles: {
          ENV['APP_BUNDLE_ID'] => "match AppStore #{ENV['APP_BUNDLE_ID']}"
        },
        compileBitcode: false,
        destination: "export"
      },
      output_directory: output_dir,
      output_name: "Runner",
      xcargs: "FLUTTER_BUILD_NAME=#{marketing_version} FLUTTER_BUILD_NUMBER=#{build_number}"
    )

    ipa_path = Actions.lane_context[SharedValues::IPA_OUTPUT_PATH] || Dir[File.join(output_dir, "*.ipa")].first
    UI.user_error!("IPA not found in build/ios/ipa") unless ipa_path

    UI.message("Uploading IPA to TestFlight (internal)")
    pilot(
      ipa: ipa_path,
      distribute_external: false,
      api_key: api_key,
      skip_submission: true,
      skip_waiting_for_build_processing: false
    )
  end
end
